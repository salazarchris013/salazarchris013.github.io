<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Inventory Title -->
    <TextView
        android:id="@+id/inventoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inventory"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Item Input -->
    <EditText
        android:id="@+id/itemName"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="Item"
        android:layout_margin="8dp"
        app:layout_constraintTop_toBottomOf="@id/inventoryTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/itemQty"/>

    <!-- Quantity Input -->
    <EditText
        android:id="@+id/itemQty"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="Qty"
        android:inputType="number"
        android:layout_margin="8dp"
        app:layout_constraintTop_toBottomOf="@id/inventoryTitle"
        app:layout_constraintStart_toEndOf="@id/itemName"
        app:layout_constraintEnd_toStartOf="@id/itemDesc"/>

    <!-- Description Input -->
    <EditText
        android:id="@+id/itemDesc"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="Description"
        android:layout_margin="8dp"
        app:layout_constraintTop_toBottomOf="@id/inventoryTitle"
        app:layout_constraintStart_toEndOf="@id/itemQty"
        app:layout_constraintEnd_toStartOf="@id/addItemBtn"/>

    <!-- Add Button -->
    <Button
        android:id="@+id/addItemBtn"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Add"
        android:layout_margin="8dp"
        app:layout_constraintTop_toBottomOf="@id/inventoryTitle"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Search Box -->
    <EditText
        android:id="@+id/searchBox"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="Search by item name"
        android:layout_margin="8dp"
        app:layout_constraintTop_toBottomOf="@id/itemName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/sortNameBtn"/>

    <!-- Sort by Name Button -->
    <Button
        android:id="@+id/sortNameBtn"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Sort: Name"
        android:layout_margin="4dp"
        app:layout_constraintTop_toBottomOf="@id/itemName"
        app:layout_constraintStart_toEndOf="@id/searchBox"
        app:layout_constraintEnd_toStartOf="@id/sortQtyBtn"/>

    <!-- Sort by Quantity Button -->
    <Button
        android:id="@+id/sortQtyBtn"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Sort: Qty"
        android:layout_margin="4dp"
        app:layout_constraintTop_toBottomOf="@id/itemName"
        app:layout_constraintStart_toEndOf="@id/sortNameBtn"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Inventory Grid -->
    <GridLayout
        android:id="@+id/inventoryGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:columnCount="3"
        android:layout_margin="16dp"
        android:background="#EEEEEE"
        app:layout_constraintTop_toBottomOf="@id/searchBox"
        app:layout_constraintBottom_toTopOf="@id/smsBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Go to SMS Screen Button -->
    <Button
        android:id="@+id/smsBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Go to SMS"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>